---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import UrlBox from '../../../components/site/UrlBox.astro';
import art from '../../../data/art.json';
import { OFFICIAL } from '../../../config';
import { langPaths, useI18n } from '../../../i18n';
import { artText } from '../../../i18n/art';
export const getStaticPaths = langPaths;
const { t, p, lang } = useI18n(Astro.url);
const G = t.guide;
const toc = [['before', G.toc.before], ['sign-in', G.toc.signIn], ...G.steps.map((_, i) => [`step-${i + 1}`, G.toc.step(i + 1)]), ['after', G.toc.after], ['sources', G.toc.sources]];
const sources = [{ ...OFFICIAL.ftaEinvoicing, label: t.official.fta }, { ...OFFICIAL.emaratax, label: t.official.emaratax }, { ...OFFICIAL.mofEinvoicing, label: t.official.mof }, { ...OFFICIAL.mofAsps, label: t.official.mofAsps }];
---
<Base title={G.title} description={G.desc}>
  <section class="intro">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href={p('/')}>{G.crumbHome}</a><span aria-hidden="true">/</span><span aria-current="page">{G.crumb}</span></nav>
      <span class="kicker">{G.kicker}</span>
      <h1 class="h-page">{G.h1}</h1>
      <p class="lead">{G.lead}</p>
      <div class="urlwrap">
        <UrlBox />
        <span class="check"><Icon name="lock" size={14} color="#15683A" />{G.checkHost(OFFICIAL.emaratax.host)}</span>
      </div>
      <span class="based">{G.based}</span>
    </div>
  </section>

  <section class="wrap layout">
    <div class="side">
      <nav aria-label={G.onThisPage} class="toc">
        <span class="toc-h">{G.onThisPage}</span>
        {toc.map(([id, label]) => <a href={`#${id}`} data-toc={id}>{label}</a>)}
      </nav>
      <aside class="hand">
        <span class="hand-h"><span class="av"><svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7a3 3 0 1 0 6 0a3 3 0 1 0-6 0z M4 20c.6-3.6 3.8-6 8-6s7.4 2.4 8 6" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><b>{G.handTitle}</b></span>
        <p>{G.handText}</p>
        <a href={p('/pricing')} class="hand-btn">{G.handCta}<Icon name="arrow" size={14} /></a>
      </aside>
    </div>

    <article class="body">
      <section id="before" class="sec first">
        <h2 class="h2">{G.beforeTitle}</h2>
        <ul class="ticks">{G.before.map((item) => <li><Icon name="check" size={18} color="#1F4FD8" />{item}</li>)}</ul>
      </section>

      <section id="sign-in" class="help">
        <h2 class="h2s">{G.helpTitle}</h2>
        <p class="p">{G.helpText}</p>
        <div class="hcards">
          {G.loginHelp.map((h) => (
            <div class="hcard">
              <span class="hic"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d={h.icon} fill="none" stroke="#1740B3" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
              <span class="stack gap4"><b>{h.title}</b><span>{h.text}</span></span>
            </div>
          ))}
        </div>
        <p class="p ink">{G.nobodyBefore}<a href={OFFICIAL.ftaEinvoicing.url} target="_blank" rel="noopener noreferrer" class="link">tax.gov.ae<Icon name="external" size={13} /></a>{G.nobodyAfter}</p>
      </section>

      {G.steps.map((s, i) => (
        <section id={`step-${i + 1}`} class="sec">
          <span class="snum"><span class="n">{i + 1}</span><span class="kicker">{G.stepOf(i + 1)}</span></span>
          <h2 class="h2">{s.title}</h2>
          <p class="p lg">{s.text}</p>
          {i === 0 && <UrlBox />}
          <div class="wire" dir="ltr" set:html={artText(art.guideWires[i], lang)} />
          <p class="tip"><Icon name="bulb" size={20} color="#1740B3" stroke={1.8} /><span>{s.tip}</span></p>
        </section>
      ))}

      <section id="after" class="sec">
        <h2 class="h2">{G.afterTitle}</h2>
        <ul class="ticks">{G.after.map((item) => <li><Icon name="check" size={18} color="#1F4FD8" />{item}</li>)}</ul>
        <a href={p('/contact')} class="link">{G.stuck}<Icon name="arrow" size={14} /></a>
      </section>

      <section id="sources" class="sec">
        <h2 class="h2">{G.sourcesTitle}</h2>
        <p class="p">{G.sourcesText}</p>
        <ul class="srcs">
          {sources.map((o) => <li><a href={o.url} target="_blank" rel="noopener noreferrer"><span class="stack gap2"><b>{o.label}</b><span class="mono">{o.url.replace(/^https:\/\//, '').replace(/\/$/, '')}</span></span><Icon name="external" size={16} /></a></li>)}
        </ul>
      </section>
    </article>
  </section>
</Base>

<style>
  .gap2 { gap: 2px; } .gap4 { gap: 4px; }
  .urlwrap { max-width: 720px; display: flex; flex-direction: column; gap: 10px; padding-top: 6px; }
  .check { display: flex; align-items: center; gap: 6px; font-size: 14px; color: var(--ink-2); }
  .based { font-size: 14px; color: var(--ink-3); }
  .layout { padding-block: 56px 88px; display: grid; grid-template-columns: 260px minmax(0, 860px); gap: 64px; align-items: start; }
  .side { position: sticky; top: 24px; display: flex; flex-direction: column; gap: 28px; }
  .toc { display: flex; flex-direction: column; gap: 2px; }
  .toc-h { padding: 0 12px 8px; font-size: 12px; font-weight: 600; letter-spacing: 0.04em; color: var(--ink-3); }
  .toc a { display: block; padding: 8px 12px; border-radius: 10px; font-size: 14px; text-decoration: none; color: var(--ink-2); }
  .toc a:hover { background: var(--paper-2); }
  .toc a.on { background: var(--cobalt-tint); color: var(--cobalt-ink); font-weight: 600; }
  .hand { display: flex; flex-direction: column; gap: 12px; padding: 18px 18px 20px; border-radius: 14px; background: linear-gradient(160deg, #EEF3FF 0%, #E2EAFF 100%); box-shadow: inset 0 0 0 1px #C3D3FF; }
  .hand-h { display: flex; align-items: center; gap: 10px; }
  .hand-h b { font-size: 16px; line-height: 22px; font-weight: 600; color: var(--navy); }
  .av { width: 34px; height: 34px; flex: 0 0 auto; border-radius: 999px; background: var(--cobalt); display: flex; align-items: center; justify-content: center; }
  .hand p { font-size: 14px; line-height: 22px; }
  .hand-btn { height: 40px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; border-radius: 999px; background: #fff; box-shadow: inset 0 0 0 1.5px var(--cobalt); font-size: 14px; font-weight: 600; color: var(--cobalt-ink); text-decoration: none; }
  .hand-btn:hover { background: var(--cobalt-tint); }
  .body { display: flex; flex-direction: column; gap: 40px; min-width: 0; }
  .sec { display: flex; flex-direction: column; gap: 16px; padding-top: 40px; border-top: 1px solid var(--line); scroll-margin-top: 24px; }
  .sec.first { padding-top: 0; border-top: 0; }
  .h2 { font-size: clamp(24px, 2.2vw, 30px); line-height: 1.2; font-weight: 600; letter-spacing: -0.02em; }
  .h2s { font-size: clamp(22px, 2vw, 26px); line-height: 1.23; font-weight: 600; letter-spacing: -0.02em; }
  .p { font-size: 16px; line-height: 25px; color: var(--ink-2); }
  .p.lg { font-size: 17px; line-height: 27px; }
  .p.ink { font-size: 15px; line-height: 23px; color: var(--ink); }
  .p .link { display: inline-flex; gap: 3px; }
  .help { display: flex; flex-direction: column; gap: 16px; padding: 28px; border-radius: 14px; background: var(--wash); scroll-margin-top: 24px; }
  .hcards { display: flex; flex-direction: column; gap: 10px; }
  .hcard { display: flex; gap: 14px; padding: 18px 20px; border-radius: 12px; background: #fff; border: 1px solid var(--line); }
  .hcard b { font-size: 16px; line-height: 22px; font-weight: 600; }
  .hcard span span { font-size: 15px; line-height: 23px; color: var(--ink-2); }
  .hic { width: 36px; height: 36px; flex: 0 0 auto; border-radius: 10px; background: var(--cobalt-tint); display: flex; align-items: center; justify-content: center; }
  .snum { display: flex; align-items: center; gap: 12px; }
  .n { width: 36px; height: 36px; border-radius: 999px; background: var(--cobalt); color: #fff; display: flex; align-items: center; justify-content: center; font: 800 17px var(--display); }
  .wire { min-width: 0; overflow: hidden; border-radius: 14px; }
  .wire :global(> *) { max-width: 100%; }
  .tip { display: flex; gap: 10px; padding: 14px 16px; border-radius: 12px; background: var(--wash); font-size: 15px; line-height: 23px; }
  .tip :global(svg) { flex: 0 0 auto; margin-top: 1px; }
  .srcs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .srcs a { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 18px; border-radius: 12px; border: 1px solid var(--line); text-decoration: none; color: var(--cobalt-ink); }
  .srcs a:hover { border-color: var(--cobalt-soft); background: var(--cobalt-tint); }
  .srcs b { font-size: 15px; font-weight: 600; color: var(--ink); }
  .srcs .mono { font-size: 12px; color: var(--ink-3); overflow-wrap: anywhere; }
  .srcs :global(svg) { flex: 0 0 auto; }
  @media (max-width: 1099px) {
    .layout { grid-template-columns: 1fr; gap: 40px; }
    .side { position: static; }
    .toc { display: none; }
  }
  @media (max-width: 600px) { .help { padding: 20px; } .srcs { grid-template-columns: 1fr; } }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const set = (id: string) => links.forEach((a) => a.classList.toggle('on', a.dataset.toc === id));
  set(links[0]?.dataset.toc ?? '');
  const io = new IntersectionObserver((es) => {
    const vis = es.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
    if (vis[0]) set(vis[0].target.id);
  }, { rootMargin: '0px 0px -70% 0px' });
  links.forEach((a) => { const el = document.getElementById(a.dataset.toc!); if (el) io.observe(el); });
</script>
