---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Band from '../../components/site/Band.astro';
import { BANDS, fmtDate } from '../../data/dates';
import { COMPANY, OFFICIAL } from '../../config';
import { langPaths, useI18n } from '../../i18n';
export const getStaticPaths = langPaths;
const { t, p, w, lang } = useI18n(Astro.url);
const A = t.about;
const LANES = BANDS.map((band, i) => ({ group: t.dates.groups[i], a: fmtDate(band.a.t, lang), g: fmtDate(band.g.t, lang) }));
---
<Base title={A.title} description={A.desc}>
  <section class="intro">
    <div class="wrap">
      <span class="kicker">{A.kicker}</span>
      <h1 class="h-page">{A.h1Before}<span class="nowrap">{A.h1Nowrap}</span>{A.h1After}</h1>
      <p class="lead">{A.lead(COMPANY.name)}</p>
    </div>
  </section>

  <section class="wrap why">
    <div class="stack gap16">
      <span class="kicker">{A.whyKicker}</span>
      <h2 class="h-block">{A.whyTitle}</h2>
      {A.why.map((para) => <p class="p">{para}</p>)}
    </div>
    <div class="dates">
      {LANES.map((l) => (
        <div class="date card">
          <span class="grp">{l.group}</span>
          <div class="pair">
            <span class="stack gap2"><span class="k">{A.appointBy}</span><b>{l.a}</b></span>
            <span class="stack gap2"><span class="k">{A.einvFrom}</span><b>{l.g}</b></span>
          </div>
        </div>
      ))}
      <a href={OFFICIAL.mofEinvoicing.url} target="_blank" rel="noopener noreferrer" class="link src">{A.source}<Icon name="external" size={13} /></a>
    </div>
  </section>

  <section class="wrap does-sec">
    <div class="stack gap10"><span class="kicker">{A.doesKicker}</span><h2 class="h-block">{A.doesTitle}</h2></div>
    <div class="does">
      {A.does.map((x, i) => (
        <article class="do card">
          <span class="n">{i + 1}</span>
          <h3>{x.t}</h3>
          <p>{x.d}</p>
          <a href={p(x.h)} class="link">{x.l}<Icon name="arrow" size={14} /></a>
        </article>
      ))}
    </div>
  </section>

  <section class="how-sec">
    <div class="wrap">
      <div class="stack gap10"><span class="kicker">{A.howKicker}</span><h2 class="h-block">{A.howTitle}</h2></div>
      <div class="how">
        {A.how.map((x) => <div class="stack gap8"><span class="tick"><Icon name="check" size={18} color="#fff" /></span><b>{x.t}</b><span class="d">{x.d}</span></div>)}
      </div>
    </div>
  </section>

  <section class="wrap company" id="company">
    <div class="stack gap16">
      <span class="kicker">{A.companyKicker}</span>
      <h2 class="h-block">{A.companyTitle(COMPANY.name)}</h2>
      {A.companyText.map((para) => <p class="p">{para}</p>)}
      <div class="acts">
        <a href={COMPANY.url} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">{A.visit(COMPANY.host)}<Icon name="external" size={14} /></a>
        <a href={p('/contact')} class="link">{A.contactTeam}<Icon name="arrow" size={14} /></a>
      </div>
    </div>
    <a href={COMPANY.url} target="_blank" rel="noopener noreferrer" class="co-card" aria-label={A.cardAria(COMPANY.name, COMPANY.host)}>
      <span class="co-k">{A.cardKicker}</span>
      <b class="co-name">{COMPANY.name}</b>
      <span class="co-host">{COMPANY.host}<Icon name="external" size={14} /></span>
      <span class="co-rel"><span class="co-dot" aria-hidden="true"></span>{A.cardRel}</span>
    </a>
  </section>

  <Band title={A.bandTitle} text={A.bandText} href={w('signup')} />
</Base>

<style>
  .gap2 { gap: 2px; } .gap8 { gap: 8px; } .gap10 { gap: 10px; } .gap16 { gap: 16px; }
  .p { font-size: 17px; line-height: 27px; color: var(--ink-2); max-width: 640px; }
  .why { padding-block: 72px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 520px); gap: 48px 80px; align-items: center; }
  .dates { display: flex; flex-direction: column; gap: 14px; }
  .date { display: flex; flex-direction: column; gap: 14px; padding: 22px 24px; box-shadow: 0 16px 40px rgba(11,31,92,0.06); }
  .grp { font: 500 13px/18px var(--mono); color: var(--cobalt-ink); }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .pair .k { font-size: 13px; color: var(--ink-3); }
  .pair b { font: 800 24px/30px var(--display); letter-spacing: -0.02em; color: var(--navy); white-space: nowrap; }
  @media (max-width: 600px) { :lang(zh) .pair b { font-size: 16px; line-height: 24px; letter-spacing: 0; } }
  .src { align-self: flex-start; font-size: 14px; }
  .does-sec { padding-block: 8px 80px; display: flex; flex-direction: column; gap: 28px; }
  .does { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .do { display: flex; flex-direction: column; gap: 12px; padding: 28px; }
  .do .n { width: 36px; height: 36px; border-radius: 999px; background: var(--cobalt); color: #fff; display: flex; align-items: center; justify-content: center; font: 800 17px var(--display); }
  .do h3 { margin: 4px 0 0; font-size: 20px; line-height: 26px; font-weight: 600; }
  .do p { flex: 1 1 auto; font-size: 15px; line-height: 23px; color: var(--ink-2); }
  .how-sec { background: var(--wash); }
  .how-sec .wrap { padding-block: 72px; display: flex; flex-direction: column; gap: 32px; }
  .how { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .tick { width: 32px; height: 32px; border-radius: 999px; background: var(--cobalt); display: flex; align-items: center; justify-content: center; margin-bottom: 4px; }
  .how b { font-size: 18px; font-weight: 600; }
  .how .d { font-size: 15px; line-height: 23px; color: var(--ink-2); }
  .company { padding-block: 80px 88px; display: grid; grid-template-columns: minmax(0, 1fr) 440px; gap: 48px 80px; align-items: center; scroll-margin-top: 24px; }
  .todo { max-width: 640px; padding: 16px 18px; border-radius: 10px; border: 1px dashed #C9D2DD; background: #FAFBFC; font-size: 15px; line-height: 24px; color: var(--ink-3); }
  .acts { display: flex; align-items: center; gap: 14px 24px; flex-wrap: wrap; padding-top: 8px; }
  .co-card { position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 10px; padding: 32px 36px 36px; min-height: 260px; border-radius: 18px; background: var(--navy); color: #fff; text-decoration: none; box-shadow: 0 30px 70px rgba(11,31,92,0.22); }
  .co-card::before { content: ''; position: absolute; inset: 0; background: radial-gradient(70% 80% at 100% 0%, rgba(47,102,242,0.6), rgba(47,102,242,0) 70%); }
  .co-card > * { position: relative; }
  .co-k { margin-bottom: auto; padding-bottom: 28px; font: 500 13px/18px var(--mono); color: var(--cobalt-soft); }
  .co-name { font: 800 44px/50px var(--display); letter-spacing: -0.03em; }
  .co-host { display: inline-flex; align-items: center; gap: 6px; font: 500 15px var(--mono); color: #DCE6FF; }
  .co-rel { display: inline-flex; align-items: center; gap: 8px; margin-top: 10px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.18); font-size: 14px; color: #E6ECFF; }
  .co-dot { width: 8px; height: 8px; border-radius: 999px; background: var(--cobalt-soft); }
  .co-card:hover .co-host { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 1099px) {
    .why, .company { grid-template-columns: 1fr; }
    .does, .how { grid-template-columns: 1fr; max-width: 640px; }
    .why { padding-block: 56px; }
  }
  @media (max-width: 600px) { .do, .date { padding: 20px; } .co-card { padding: 24px 28px 28px; min-height: 220px; } .co-name { font-size: 36px; line-height: 42px; } .pair b { font-size: 20px; line-height: 26px; } }
</style>
