---
// Small line icons used across the site.
interface Props { name: 'check' | 'arrow' | 'external' | 'cross' | 'globe' | 'menu' | 'close' | 'lock' | 'copy' | 'mail' | 'bulb' | 'report'; size?: number; color?: string; stroke?: number; class?: string }
const { name, size = 16, color = 'currentColor', stroke, class: cls } = Astro.props;
const P: Record<string, [string, number]> = {
  check: ['M5 12.5l4.5 4.5L19 7.5', 3],
  arrow: ['M5 12h14 M13 6l6 6l-6 6', 2.4],
  external: ['M14 4h6v6 M20 4l-9 9 M18 14v6H4V6h6', 2.2],
  cross: ['M7 7l10 10 M17 7L7 17', 2.4],
  globe: ['M21 12a9 9 0 1 1-18 0a9 9 0 1 1 18 0z M3 12h18 M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9 M12 3c-2.5 2.6-3.8 5.6-3.8 9s1.3 6.4 3.8 9', 1.6],
  menu: ['M4 7h16 M4 12h16 M4 17h16', 2],
  close: ['M6 6l12 12 M18 6L6 18', 2.2],
  lock: ['M6 11h12v9H6z M8.5 11V8a3.5 3.5 0 0 1 7 0v3', 2],
  copy: ['M9 9h11v11H9z M5 15H4V4h11v1', 2],
  mail: ['M4 6h16v12H4z M4 7l8 6l8-6', 2],
  report: ['M12 15V4 M7.5 8.5L12 4l4.5 4.5 M5 14v6h14v-6', 2.6],
  bulb: ['M9 18h6 M10 21h4 M12 3a6 6 0 0 0-4 10.5c.8.8 1 1.5 1 2.5h6c0-1 .2-1.7 1-2.5A6 6 0 0 0 12 3z', 1.8],
};
const [d, sw] = P[name];
---
<svg class:list={[cls, { 'i-flip': name === 'arrow' || name === 'external' }]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={d} fill="none" stroke={color} stroke-width={stroke ?? sw} stroke-linecap="round" stroke-linejoin="round"></path></svg>
